# Either provide a full URI, or use the existing four-variable format below.
# MONGODB_URI=mongodb://user:password@host:27017/database
MONGODB_ADDR=127.0.0.1:27017
MONGO_USERNAME=
MONGO_PWD=
MONGO_DBNAME=multisite_cms
ADMIN_KEY=change-this-admin-key
SESSION_SECRET=change-this-to-a-long-random-string
DEFAULT_SITE_ID=readfit
# Media uploads are stored under <UPLOAD_DIR>/<siteId>/... and served at /uploads/...
UPLOAD_DIR=uploads

# `node .output/server/index.mjs` production runtime aliases
# NUXT_MONGODB_URI=mongodb://user:password@host:27017/database
# NUXT_MONGODB_ADDR=127.0.0.1:27017
# NUXT_MONGO_USERNAME=
# NUXT_MONGO_PWD=
# NUXT_MONGO_DBNAME=multisite_cms
# NUXT_ADMIN_KEY=change-this-admin-key
# NUXT_SESSION_SECRET=change-this-to-a-long-random-string
# NUXT_DEFAULT_SITE_ID=readfit
